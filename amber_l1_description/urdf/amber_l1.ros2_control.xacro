<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
    <xacro:macro name="amberl1_ros2_control" params="prefix is_hw is_ethercat">

        <xacro:if value="${is_hw == 'false'}">
            <ros2_control name="GazeboSystem" type="system">
                <hardware>
                    <plugin>gazebo_ros2_control/GazeboSystem</plugin>
                </hardware>
                <joint name="${prefix}joint1">
                    <command_interface name="position">
                        <param name="min">-2.4435</param> <param name="max">2.4435</param>
                    </command_interface>
                    <state_interface name="position"/> <state_interface name="velocity"/> <state_interface name="effort"/>
                </joint>
                <joint name="${prefix}joint2">
                    <command_interface name="position">
                        <param name="min">-2.3213</param> <param name="max">2.3213</param>
                    </command_interface>
                    <state_interface name="position"/> <state_interface name="velocity"/> <state_interface name="effort"/>
                </joint>
                <joint name="${prefix}joint3">
                    <command_interface name="position">
                        <param name="min">-2.2863</param> <param name="max">2.2863</param>
                    </command_interface>
                    <state_interface name="position"/> <state_interface name="velocity"/> <state_interface name="effort"/>
                </joint>
                <joint name="${prefix}joint4">
                    <command_interface name="position">
                        <param name="min">-2.2863</param> <param name="max">2.2863</param>
                    </command_interface>
                    <state_interface name="position"/> <state_interface name="velocity"/> <state_interface name="effort"/>
                </joint>
                <joint name="${prefix}joint5">
                    <command_interface name="position">
                        <param name="min">-2.2863</param> <param name="max">2.2863</param>
                    </command_interface>
                    <state_interface name="position"/> <state_interface name="velocity"/> <state_interface name="effort"/>
                </joint>
                <joint name="${prefix}joint6">
                    <command_interface name="position">
                        <param name="min">-2.2863</param> <param name="max">2.2863</param>
                    </command_interface>
                    <state_interface name="position"/> <state_interface name="velocity"/> <state_interface name="effort"/>
                </joint>
                <joint name="${prefix}joint7">
                    <command_interface name="position">
                        <param name="min">-3.05</param> <param name="max">3.05</param>
                    </command_interface>
                    <state_interface name="position"/> <state_interface name="velocity"/> <state_interface name="effort"/>
                </joint>
                <joint name="${prefix}gripper_finger_left_joint">
                    <command_interface name="effort">
                        <param name="min">-1.0</param> <param name="max">1.0</param>
                    </command_interface>
                    <state_interface name="position"/> <state_interface name="velocity"/> <state_interface name="effort"/>
                </joint>
                <joint name="${prefix}gripper_finger_right_joint">
                    <command_interface name="effort">
                        <param name="min">-1.0</param> <param name="max">1.0</param>
                    </command_interface>
                    <state_interface name="position"/> <state_interface name="velocity"/> <state_interface name="effort"/>
                </joint>
            </ros2_control>
        </xacro:if>

        <xacro:unless value="${is_hw == 'false'}">
            <!-- Original ros2_control block for hardware -->
            <ros2_control name="amber_l1_position" type="system">
                <hardware>
                    <plugin>AmberB1Hardware</plugin>
                    <param name="is_hw">${is_hw}</param>
                    <param name="is_ethercat">${is_ethercat}</param>
                    <param name="robot_type">2</param>
                </hardware>
                <joint name="${prefix}joint1">
                    <command_interface name="position">
                        <param name="min">-2.4435</param>
                        <param name="max">2.4435</param>
                    </command_interface>
                    <command_interface name="velocity">
                        <param name="min">-3.14</param>
                        <param name="max">3.14</param>
                    </command_interface>
                    <state_interface name="position"/>
                    <state_interface name="velocity"/>
                    <state_interface name="effort"/>
                </joint>
                <joint name="${prefix}joint2">
                    <command_interface name="position">
                        <param name="min">-2.3213</param>
                        <param name="max">2.3213</param>
                    </command_interface>
                    <command_interface name="velocity">
                        <param name="min">-3.14</param>
                        <param name="max">3.14</param>
                    </command_interface>
                    <state_interface name="position"/>
                    <state_interface name="velocity"/>
                    <state_interface name="effort"/>
                </joint>
                <joint name="${prefix}joint3">
                    <command_interface name="position">
                        <param name="min">-2.2863</param>
                        <param name="max">2.2863</param>
                    </command_interface>
                    <command_interface name="velocity">
                        <param name="min">-3.14</param>
                        <param name="max">3.14</param>
                    </command_interface>
                    <state_interface name="position"/>
                    <state_interface name="velocity"/>
                    <state_interface name="effort"/>
                </joint>
                <joint name="${prefix}joint4">
                    <command_interface name="position">
                        <param name="min">-2.2863</param>
                        <param name="max">2.2863</param>
                    </command_interface>
                    <command_interface name="velocity">
                        <param name="min">-3.14</param>
                        <param name="max">3.14</param>
                    </command_interface>
                    <state_interface name="position"/>
                    <state_interface name="velocity"/>
                    <state_interface name="effort"/>
                </joint>
                <joint name="${prefix}joint5">
                    <command_interface name="position">
                        <param name="min">-2.2863</param>
                        <param name="max">2.2863</param>
                    </command_interface>
                    <command_interface name="velocity">
                        <param name="min">-5.23</param>
                        <param name="max">5.23</param>
                    </command_interface>
                    <state_interface name="position"/>
                    <state_interface name="velocity"/>
                    <state_interface name="effort"/>
                </joint>
                <joint name="${prefix}joint6">
                    <command_interface name="position">
                        <param name="min">-2.2863</param>
                        <param name="max">2.2863</param>
                    </command_interface>
                    <command_interface name="velocity">
                        <param name="min">-5.23</param>
                        <param name="max">5.23</param>
                    </command_interface>
                    <state_interface name="position"/>
                    <state_interface name="velocity"/>
                    <state_interface name="effort"/>
                </joint>
                <joint name="${prefix}joint7">
                    <command_interface name="position">
                        <param name="min">-3.05</param>
                        <param name="max">3.05</param>
                    </command_interface>
                    <command_interface name="velocity">
                        <param name="min">-5.23</param>
                        <param name="max">5.23</param>
                    </command_interface>
                    <state_interface name="position"/>
                    <state_interface name="velocity"/>
                    <state_interface name="effort"/>
                </joint>
                <!-- Gripper joints are not typically controlled by the same AmberB1Hardware for real robot,
                     assuming they might have a separate controller or are not present on the real hardware variant.
                     If they are, they would need to be added here as well. For now, leaving them out of the hardware block. -->
            </ros2_control>
        </xacro:unless>
    </xacro:macro>
</robot>
